import { motion } from "framer-motion";

function Experience() {
  const experiences = [
    {
      number: "01",
      date: "JUN 2026 — JUL 2026",
      short: "BLW",
      role: "Industrial Intern · EDP Department",
      company: "Banaras Locomotive Works, Varanasi",
      points: [
        "Worked on EDP operations and industrial data management.",
        "Gained exposure to CNC programming and manufacturing processes.",
        "Learned industrial workflow and technical documentation.",
      ],
    },
    {
      number: "02",
      date: "JAN 2026 — MAR 2026",
      short: "OLINP",
      role: "Data Analyst & Machine Learning Intern",
      company: "Olinp Technology Pvt. Limited",
      points: [
        "Worked on data analysis and preprocessing techniques.",
        "Explored machine learning concepts and practical AI solutions.",
        "Worked with datasets to generate meaningful insights.",
      ],
    },
  ];

  const globeDots = Array.from({ length: 230 }, (_, i) => {
    const phi = Math.acos(1 - (2 * (i + 0.5)) / 230);
    const theta = Math.PI * (1 + Math.sqrt(5)) * i;

    const x = Math.sin(phi) * Math.cos(theta);
    const y = Math.cos(phi);
    const z = Math.sin(phi) * Math.sin(theta);

    const visible = z > -0.15;
    const left = 50 + x * 44;
    const top = 50 - y * 44;
    const size = 1.4 + (z + 1) * 0.8;
    const opacity = visible ? 0.35 + (z + 1) * 0.25 : 0.08;

    return { left, top, size, opacity };
  });

  return (
    <section
      id="experience"
      className="relative overflow-hidden bg-[#F7F3ED] px-6 py-28 text-[#201813] md:px-10 md:py-36"
    >
      <div className="mx-auto max-w-7xl">
        {/* Heading */}
        <motion.div
          initial={{ opacity: 0, y: 25 }}
          whileInView={{ opacity: 1, y: 0 }}
          viewport={{ once: true }}
          transition={{ duration: 0.7 }}
          className="mb-20"
        >
          <div className="flex items-end gap-5">
            <span className="font-serif text-2xl italic text-[#D9542B]">
              02
            </span>

            <h2 className="font-serif text-5xl font-semibold tracking-[-0.04em] md:text-7xl">
              Experience
            </h2>
          </div>

          <div className="mt-6 h-px w-full bg-[#201813]/15" />

          <p className="mt-6 max-w-2xl text-base leading-7 text-[#665950] md:text-lg">
            From industrial systems and data operations to machine learning,
            my experience combines practical engineering with intelligent
            software development.
          </p>
        </motion.div>

        {/* Intro + Globe */}
        <div className="grid items-center gap-16 lg:grid-cols-[0.85fr_1.15fr]">
          {/* Left intro */}
          <motion.div
            initial={{ opacity: 0, x: -35 }}
            whileInView={{ opacity: 1, x: 0 }}
            viewport={{ once: true }}
            transition={{ duration: 0.8 }}
          >
            <p className="mb-5 text-xs font-medium uppercase tracking-[0.3em] text-[#9A6954]">
              Professional Journey
            </p>

            <h3 className="max-w-xl font-serif text-4xl italic leading-tight md:text-5xl">
              Learning, building and working across{" "}
              <span className="not-italic">AI, data and engineering.</span>
            </h3>

            <p className="mt-7 max-w-xl leading-7 text-[#665950]">
              My internships gave me exposure to both industrial engineering
              environments and modern data-driven development. From BLW's
              industrial EDP operations to Olinp's machine learning and data
              work, each experience added a different layer to my technical
              journey.
            </p>
          </motion.div>

          {/* Dotted Globe */}
          <motion.div
            initial={{ opacity: 0, scale: 0.88 }}
            whileInView={{ opacity: 1, scale: 1 }}
            viewport={{ once: true }}
            transition={{ duration: 1 }}
            className="relative mx-auto h-[390px] w-[390px] max-w-full md:h-[500px] md:w-[500px]"
          >
            {/* Orbit */}
            <motion.div
              animate={{ rotate: 360 }}
              transition={{
                duration: 35,
                repeat: Infinity,
                ease: "linear",
              }}
              className="absolute inset-[7%] rounded-full border border-[#201813]/10"
            />

            <motion.div
              animate={{ rotate: -360 }}
              transition={{
                duration: 50,
                repeat: Infinity,
                ease: "linear",
              }}
              className="absolute inset-[15%] rounded-full border border-dashed border-[#D9542B]/20"
            />

            {/* Globe */}
            <motion.div
              animate={{ rotateY: [0, 8, 0, -8, 0] }}
              transition={{
                duration: 10,
                repeat: Infinity,
                ease: "easeInOut",
              }}
              className="absolute left-1/2 top-1/2 h-[76%] w-[76%] -translate-x-1/2 -translate-y-1/2 rounded-full border border-[#201813]/10 bg-[#EFEAE2] shadow-[inset_-35px_-20px_70px_rgba(32,24,19,0.08),0_25px_70px_rgba(32,24,19,0.08)]"
              style={{ transformStyle: "preserve-3d" }}
            >
              {globeDots.map((dot, index) => (
                <span
                  key={index}
                  className="absolute rounded-full bg-[#201813]"
                  style={{
                    left: `${dot.left}%`,
                    top: `${dot.top}%`,
                    width: `${dot.size}px`,
                    height: `${dot.size}px`,
                    opacity: dot.opacity,
                    transform: "translate(-50%, -50%)",
                  }}
                />
              ))}

              {/* BLW marker */}
              <motion.div
                animate={{ scale: [1, 1.12, 1] }}
                transition={{
                  duration: 2.5,
                  repeat: Infinity,
                  ease: "easeInOut",
                }}
                className="absolute left-[39%] top-[64%] flex items-center gap-2"
              >
                <span className="h-3 w-3 rounded-full bg-[#D9542B] shadow-[0_0_0_6px_rgba(217,84,43,0.12)]" />
                <span className="rounded-full border border-[#201813]/10 bg-[#F7F3ED]/90 px-3 py-1 text-[10px] font-semibold tracking-[0.15em]">
                  BLW
                </span>
              </motion.div>

              {/* Olinp marker */}
              <motion.div
                animate={{ scale: [1, 1.12, 1] }}
                transition={{
                  duration: 2.5,
                  delay: 0.8,
                  repeat: Infinity,
                  ease: "easeInOut",
                }}
                className="absolute left-[47%] top-[48%] flex items-center gap-2"
              >
                <span className="h-3 w-3 rounded-full bg-[#D9542B] shadow-[0_0_0_6px_rgba(217,84,43,0.12)]" />
                <span className="rounded-full border border-[#201813]/10 bg-[#F7F3ED]/90 px-3 py-1 text-[10px] font-semibold tracking-[0.15em]">
                  OLINP
                </span>
              </motion.div>
            </motion.div>

            <div className="absolute bottom-1 left-1/2 -translate-x-1/2 text-center">
              <p className="text-[10px] uppercase tracking-[0.35em] text-[#9A6954]">
                India · IST
              </p>
            </div>
          </motion.div>
        </div>

        {/* Experience Cards */}
        <div className="mt-24">
          {experiences.map((exp, index) => (
            <motion.article
              key={exp.company}
              initial={{ opacity: 0, y: 35 }}
              whileInView={{ opacity: 1, y: 0 }}
              viewport={{ once: true, amount: 0.2 }}
              transition={{ duration: 0.7, delay: index * 0.12 }}
              className="group border-t border-[#201813]/15 py-9"
            >
              <div className="grid gap-6 md:grid-cols-[80px_1fr_auto] md:items-start">
                <span className="font-serif text-xl italic text-[#D9542B]">
                  {exp.number}
                </span>

                <div>
                  <div className="mb-3 flex flex-wrap items-center gap-3">
                    <span className="text-xs uppercase tracking-[0.2em] text-[#9A6954]">
                      {exp.short}
                    </span>

                    <span className="h-1 w-1 rounded-full bg-[#D9542B]" />

                    <span className="text-xs uppercase tracking-[0.18em] text-[#9A6954]">
                      {exp.date}
                    </span>
                  </div>

                  <h3 className="font-serif text-3xl font-semibold tracking-[-0.025em] md:text-4xl">
                    {exp.company}
                  </h3>

                  <p className="mt-2 text-lg text-[#665950]">{exp.role}</p>

                  <ul className="mt-6 grid gap-2 text-sm leading-6 text-[#665950] md:grid-cols-3">
                    {exp.points.map((point) => (
                      <li key={point} className="pr-5">
                        <span className="mr-2 text-[#D9542B]">•</span>
                        {point}
                      </li>
                    ))}
                  </ul>
                </div>

                <span className="hidden text-sm text-[#9A6954] transition-transform duration-300 group-hover:translate-x-1 md:block">
                  VIEW EXPERIENCE →
                </span>
              </div>
            </motion.article>
          ))}
        </div>
      </div>
    </section>
  );
}

export default Experience;
